<Window x:Class="WpfApp5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="Арома Дом — Список материалов"
        Height="650" Width="900"
        MinHeight="450" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackgroundBrush}"
        FontFamily="{StaticResource MainFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с логотипом -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="16,10">
            <DockPanel LastChildFill="True">
                <Image x:Name="LogoImage"
                       DockPanel.Dock="Left"
                       Height="60"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <Button x:Name="AddButton"
                        DockPanel.Dock="Right"
                        Content="Добавить материал"
                        Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center"
                        Click="AddButton_Click"/>
                <TextBlock Text="Материалы"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Список материалов в карточном виде -->
        <ListBox x:Name="MaterialsListBox"
                 Grid.Row="1"
                 Margin="16"
                 BorderThickness="0"
                 Background="{StaticResource MainBackgroundBrush}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="MaterialsListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip" Value="Нажмите, чтобы редактировать"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SecondaryBackgroundBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderText}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MinQuantityText}"
                                       FontSize="14"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding StockQuantityText}"
                                       FontSize="14"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding PriceText}"
                                       FontSize="14"
                                       Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding RequiredQuantityText}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,12,0,0"/>
                            <Button Content="Продукция с этим материалом"
                                    Style="{StaticResource AccentButtonStyle}"
                                    FontSize="13"
                                    Padding="12,4"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Click="ProductsButton_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
