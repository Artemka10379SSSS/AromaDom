<Window x:Class="WpfApp5.MaterialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp5"
        mc:Ignorable="d"
        Title="Арома Дом — Материал" Height="520" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource MainBackgroundBrush}"
        FontFamily="{StaticResource MainFont}"
        FontSize="14"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <TextBlock x:Name="HeaderTextBlock" Text="Материал" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
        </Border>

        <Grid Grid.Row="1" Margin="20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Тип материала:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,5" Padding="6,4"
                      DisplayMemberPath="Name" SelectedValuePath="Id"/>

            <TextBlock Grid.Row="1" Text="Наименование:" VerticalAlignment="Center"/>
            <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,5" Padding="6,4" MaxLength="150"/>

            <TextBlock Grid.Row="2" Text="Цена за единицу, р:" VerticalAlignment="Center"/>
            <TextBox x:Name="PriceTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5" Padding="6,4"
                     ToolTip="Не меньше 0, не больше двух знаков после запятой. Например: 450,50"/>

            <TextBlock Grid.Row="3" Text="Единица измерения:" VerticalAlignment="Center"/>
            <TextBox x:Name="UnitTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5" Padding="6,4" MaxLength="20"
                     ToolTip="Например: кг, л, шт, м"/>

            <TextBlock Grid.Row="4" Text="Количество в упаковке:" VerticalAlignment="Center"/>
            <TextBox x:Name="PackageTextBox" Grid.Row="4" Grid.Column="1" Margin="0,5" Padding="6,4"/>

            <TextBlock Grid.Row="5" Text="Количество на складе:" VerticalAlignment="Center"/>
            <TextBox x:Name="StockTextBox" Grid.Row="5" Grid.Column="1" Margin="0,5" Padding="6,4"/>

            <TextBlock Grid.Row="6" Text="Минимальное количество:" VerticalAlignment="Center"/>
            <TextBox x:Name="MinTextBox" Grid.Row="6" Grid.Column="1" Margin="0,5" Padding="6,4"
                     ToolTip="Не может быть отрицательным"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,15">
            <Button x:Name="BackButton" Content="Назад" Padding="16,6" Margin="0,0,10,0" Click="BackButton_Click"/>
            <Button x:Name="SaveButton" Content="Сохранить" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
